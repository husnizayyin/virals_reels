{
  "name": "viralreels-studio",
  "version": "1.0.0",
  "description": "Local high-retention video pipeline for Shorts, Reels, and TikTok with whisper.cpp and FFmpeg",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "subtitle:live": "tsx scripts/live-subtitle-player.ts",
    "clean:hd": "tsx scripts/clean-hd.ts",
    "setup:env": "bash scripts/setup-env.sh"
  },
  "keywords": [
    "reels",
    "shorts",
    "tiktok",
    "whisper",
    "ffmpeg",
    "subtitles",
    "karaoke",
    "qsv"
  ],
  "author": "ViralReels Team",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/multipart": "^8.3.0",
    "@fastify/static": "^7.0.4",
    "bullmq": "^5.8.2",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "ioredis": "^5.4.1",
    "pino-pretty": "^13.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "tsx": "^4.16.2",
    "typescript": "^5.5.2"
  }
}
