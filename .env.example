# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Redis Configuration (BullMQ Queue)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Media & Hardware Paths
WHISPER_BIN_PATH=./bin/whisper-cli
WHISPER_MODEL_PATH=./models/ggml-base.bin
FFMPEG_PATH=
FFPROBE_PATH=

# Hardware Optimization (Intel Core i5-1235U Baseline)
WHISPER_THREADS=4
WORKER_CONCURRENCY=1
FORCE_CPU_ENCODING=false

# Storage & Upload Limits
STORAGE_DIR=./storage
MAX_FILE_SIZE_MB=500
MAX_VIDEO_DURATION_SEC=180
TEMP_CLEANUP_HOURS=24
